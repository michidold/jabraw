#!/bin/sh
set -e
# Nach dem Entfernen der Symbole muss der Cache aufgeraeumt werden, sonst zeigt
# die Anwendungsuebersicht weiter ein Symbol ohne Anwendung. Dasselbe erzeugt
# dh_icons fuer das Quellpaket.
if command -v update-icon-caches >/dev/null 2>&1; then
    update-icon-caches /usr/share/icons/hicolor || true
fi
exit 0
