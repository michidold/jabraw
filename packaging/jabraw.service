[Unit]
Description=Jabra Headset Media Keys und Tray
Documentation=file:///usr/share/doc/jabraw/README.md
Documentation=https://github.com/michidold/jabraw
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/jabraw
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
