#!/bin/sh
set -e
# uaccess wird von 73-seat-late.rules ausgewertet; die Regel liegt deshalb
# unter 70- und muss nach der Installation einmal neu eingelesen werden.
if [ -x /bin/udevadm ] || [ -x /sbin/udevadm ]; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=hidraw || true
fi
# Gestartet wird beim Anmelden ueber /etc/xdg/autostart und waehrend einer
# laufenden Sitzung ueber die udev-Regel, die jabraw.service an das Jabra-Geraet
# haengt. Der obige Trigger startet den Daemon deshalb gleich mit, sofern ein
# Geraet steckt - ohne Ab- und Anmelden. Die Unit wird bewusst NICHT aktiviert:
# sie wird vom Geraet gezogen, und ein zweiter Daemon beendet sich ohnehin
# sofort ueber den D-Bus-Namen.
# Ohne aktualisierten Cache zeigt die Anwendungsuebersicht weiter das alte Symbol.
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -qf /usr/share/icons/hicolor 2>/dev/null || true
fi
exit 0
